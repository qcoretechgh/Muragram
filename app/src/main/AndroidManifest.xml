<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".MuragramApp"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Muragram">

        <activity
            android:name="com.dycrd.muragram.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <activity android:name="com.dycrd.muragram.LoginActivity" />
        <activity android:name="com.dycrd.muragram.QrLoginActivity" />
        <activity android:name="com.dycrd.muragram.MessagesActivity" />
        <activity android:name="com.dycrd.muragram.SettingsActivity" />
        <activity android:name="com.dycrd.muragram.PhotoViewerActivity" />
        <activity android:name="com.dycrd.muragram.MediaActivity" />
        <activity android:name="com.dycrd.muragram.EditProfileActivity" />

        <receiver android:name="com.dycrd.muragram.SecretCodeReceiver" android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="68724726" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service android:name="com.dycrd.muragram.NotificationService" />

        <provider
            android:name="com.dycrd.muragram.SearchProvider"
            android:authorities="com.dycrd.muragram.SearchProvider"
            android:label="@string/app_name"
            android:exported="true" />

    </application>

</manifest>
