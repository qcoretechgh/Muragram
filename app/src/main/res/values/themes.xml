<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GINGERBREAD (Android 2.3) PURE NATIVE THEME - NO BUBBLES MODE -->
    <style name="Theme.Muragram" parent="android:Theme">
        <item name="android:textColorLink">#FF8000</item>

        <!-- Message Bubbles: Completely Removed (Transparent) -->
        <item name="muragramMessageBubbleIn">@android:color/transparent</item>
        <item name="muragramMessageBubbleOut">@android:color/transparent</item>

        <item name="muragramBottomBarBackground">#333333</item>
        <item name="muragramLoginBoxBackground">@android:drawable/editbox_background_normal</item>
        <item name="muragramDialogFrame">@android:drawable/dialog_frame</item>
        <item name="muragramFileLayoutBackground">#333333</item>
        <item name="muragramSearchContainerBackground">@android:color/black</item>
        <item name="muragramDividerColor">@android:color/darker_gray</item>
        <item name="muragramMediaBackground">@android:color/black</item>
        <item name="muragramReplyPreviewBackground">#444444</item>
        <item name="muragramTitleBarBackground">@android:drawable/title_bar</item>

        <item name="muragramButtonStyle">?android:attr/buttonStyle</item>
        <item name="muragramButtonStyleSmall">@android:style/Widget.Button.Small</item>
    </style>

    <style name="Theme.Muragram.Dark" parent="android:Theme">
        <item name="android:textColorLink">#FF8000</item>

        <item name="muragramMessageBubbleIn">@android:color/transparent</item>
        <item name="muragramMessageBubbleOut">@android:color/transparent</item>
        <item name="muragramBottomBarBackground">#222222</item>
        <item name="muragramLoginBoxBackground">@android:drawable/editbox_background_normal</item>
        <item name="muragramDialogFrame">@android:drawable/dialog_frame</item>
        <item name="muragramFileLayoutBackground">#333333</item>
        <item name="muragramSearchContainerBackground">@android:color/black</item>
        <item name="muragramDividerColor">@android:color/darker_gray</item>
        <item name="muragramMediaBackground">@android:color/black</item>
        <item name="muragramReplyPreviewBackground">#444444</item>
        <item name="muragramTitleBarBackground">@android:drawable/title_bar</item>

        <item name="muragramButtonStyle">?android:attr/buttonStyle</item>
        <item name="muragramButtonStyleSmall">@android:style/Widget.Button.Small</item>
    </style>

    <style name="ChatItemStyle">
        <item name="android:background">@android:drawable/list_selector_background</item>
    </style>

    <style name="ChatItemTextPrimary">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ChatItemTextSecondary">
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ReplyPreviewStyle">
        <item name="android:background">#444444</item>
    </style>
</resources>
